// One click from the README gives anyone their own private copy of the app,
// running with made-up demo data. Each Codespace is isolated to the person who
// opened it: nothing is shared, and nothing they enter reaches anyone else.
{
  "name": "Finance Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  // `make env` writes backend/.env with a freshly generated encryption key, so
  // the app starts without the "set an encryption key" warning.
  "postCreateCommand": "make install && make env",
  "postAttachCommand": { "app": "make dev" },
  "forwardPorts": [5174, 8001],
  "portsAttributes": {
    "5174": { "label": "Finance Dashboard", "onAutoForward": "openPreview" },
    "8001": { "label": "API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"] }
  }
}
