# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in. Nothing here is optional if you want live
# data; the app runs fully on seeded demo data with all of it blank.
# ---------------------------------------------------------------------------

# Encrypts provider access tokens at rest in the SQLite file (AES-256-GCM).
# Generate with:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# If unset, a key is generated and stored *in the database*, which means a
# stolen database file decrypts its own tokens. Set this.
FINANCE_MASTER_KEY=

# --- Plaid : Chase, Bank of America, and Robinhood -------------------------
# One set of credentials for all three. Sign up at dashboard.plaid.com; the
# Trial plan is free, auto-approved for most signups, and covers 10 linked
# Items, which is well beyond the three this needs.
#
# Banks and brokerages are linked separately in the app because a Plaid Item's
# products are fixed when it is created — that is a UI distinction, not another
# credential.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production   (Plaid removed the old "development" environment)
PLAID_ENV=sandbox

# --- SnapTrade : Robinhood (and any other brokerage) ------------------------
# Plaid could not link Robinhood, so brokerages go through SnapTrade instead.
# SnapTrade Personal is free for your own household and needs no business
# registration: sign up at snaptrade.com, then take the client id and consumer
# key from the dashboard.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=
